<!DOCTYPE html>
<html
  lang="<%= lang %>"
  data-site="<%= site %>"
  class="notranslate"
  translate="no"
>
  <head>
    <title><%= title %></title>

    <meta charset="UTF-8" />

    <meta
      name="copyright"
      content="OZ Freemap Slovakia, http://www.freemap.sk/"
    />
    <meta name="description" content="<%= description %>" />
    <meta name="author" content="Freemap Slovakia" />
    <link rel="me" href="https://en.osm.town/@FreemapSlovakia" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no"
    />
    <meta name="color-scheme" content="light dark" />
    <meta property="fb:pages" content="146029225443232" />
    <meta
      property="article:author"
      content="https://www.facebook.com/FreemapSlovakia/"
    />

    <meta property="fb:app_id" content="171410630094006" />

    <meta property="og:site_name" content="<%= siteName %>" />
    <meta property="og:title" content="<%= title %>" />
    <meta
      property="og:image"
      content="<%= `${baseUrl}/og-${site}-${lang}.png` %>"
    />
    <meta property="og:image:width" content="<%= ogWidth %>" />
    <meta property="og:image:height" content="<%= ogHeight %>" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= baseUrl + '/' %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta
      property="og:see_also"
      content="https://play.google.com/store/apps/details?id=sk.bigware.freemap"
    />
    <meta
      property="og:see_also"
      content="https://apps.apple.com/sk/app/freemap/id6760855105"
    />

    <meta name="mobile-web-app-capable" content="yes" />

    <meta
      name="theme-color"
      content="#0d6efd"
      media="(prefers-color-scheme: light)"
    />

    <meta
      name="theme-color"
      content="#212529"
      media="(prefers-color-scheme: dark)"
    />

    <meta name="application-name" content="<%= siteName %>" />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap/sitemap-index.xml"
    />

    <link
      rel="alternate"
      type="text/plain"
      title="llms.txt — AI-readable site & URL-parameter reference"
      href="/llms.txt"
    />

    <link
      rel="manifest"
      href="/manifest-<%= site %>-<%= lang %>.webmanifest"
    />

    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- prettier-ignore -->
    <%= faviconSizes.map((size) => `
    <link rel="icon" type="image/png" sizes="${size}x${size}" href="/favicon-${size}x${size}.png" />
    `).join('') %>

    <!-- Last, and sizeless: equal candidates are resolved by document order, so
         a browser that can take the vector picks it over the PNGs above. -->
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/freemap-flower.svg"
    />

    <!-- prettier-ignore -->
    <%=
      appleTouchSizes.map((size) => `
    <link
      rel="apple-touch-icon"
      sizes="${size}x${size}"
      href="/apple-touch-icon-${size}x${size}.png"
    />
    `).join('') %>

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Freemap" />

    <meta name="apple-itunes-app" content="app-id=6760855105" />
    <!-- prettier-ignore -->
    <%=
      splashScreens.map(([w, h, r, o]) => `
    <link
      rel="apple-touch-startup-image"
      media="(device-width: ${w}px) and (device-height: ${h}px) and (-webkit-device-pixel-ratio: ${r}) and (orientation: ${o})"
      href="/apple-touch-startup-image-${site}-${(o === 'portrait' ? w : h) * r}x${(o === 'portrait' ? h : w) * r}.png"
    />
    `).join('') %>

    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="msapplication-TileImage" content="/mstile-144x144.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <script>
      if (typeof fmHeadless === 'boolean') {
        fmHeadless = fmHeadless ? {} : undefined;
      }
    </script>

    <%= htmlWebpackPlugin.tags.headTags.filter((tag) => tag.tagName !==
    'script').join('') %>

    <script>
      fmEmbedded = window.self !== window.top;

      isRobot = window.navigator.userAgent.match(
        /\b(UCBrowser|PetalBot|YaBrowser|Applebot|Googlebot|AdsBot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Sogou|ia_archiver|Mediapartners|Lighthouse)\b/,
      );
    </script>

    <% if (process.env['MATOMO_SITE_ID']) { %>
    <!-- prettier-ignore -->
    <script>
      var _paq = (window._paq = window._paq || []);
      _paq.push(['requireCookieConsent']);
      _paq.push(['setCustomUrl', '/']);
      /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
      _paq.push(['enableLinkTracking']);
      _paq.push(['setCustomDimension', 1, fmEmbedded ? 'Embedded' : 'Top']);
      _paq.push(['setCustomDimension', 2, location.hostname]);
      (function () {
        const u = '//matomo.freemap.sk/';
        _paq.push(['setTrackerUrl', u + 'matomo.php']);
        _paq.push(['setSiteId', '<%= process.env["MATOMO_SITE_ID"] %>']);

        /*
         * The tracker is fetched only once the visit looks human: on the first
         * real input, or after DWELL_SECONDS with the page visible. Until then
         * `_paq` is a plain array, so every command pushed meanwhile is queued
         * and replayed in order the moment the tracker loads — no call site
         * needs to know about the gate, and nothing is lost.
         *
         * What this drops is the drive-by that renders the page, emits a
         * pageview plus a few events and leaves within seconds without ever
         * touching it: no request reaches Matomo at all, so it costs no visit,
         * no goal conversion and no ad impression.
         *
         * The dwell fallback keeps the visitor who only reads the map, at the
         * price of being bypassable by simply waiting — hence a threshold far
         * above how long such traffic currently stays.
         */
        const DWELL_SECONDS = 60;

        const inputs = [
          'pointerdown',
          'pointermove',
          'touchstart',
          'keydown',
          'wheel',
          'scroll',
        ];

        let dwell = 0;

        const ticker = window.setInterval(function () {
          if (document.visibilityState === 'visible' && ++dwell >= DWELL_SECONDS) {
            load();
          }
        }, 1000);

        function load() {
          window.clearInterval(ticker);

          for (const input of inputs) {
            window.removeEventListener(input, load, true);
          }

          const d = document,
            g = d.createElement('script'),
            s = d.getElementsByTagName('script')[0];
          g.async = true;
          g.src = u + 'matomo.js';
          s.parentNode.insertBefore(g, s);
        }

        for (const input of inputs) {
          window.addEventListener(input, load, { capture: true, passive: true });
        }
      })();
    </script>
    <% } else { %>
    <script>
      const _paq = (window._paq = window._paq || []);
    </script>
    <% } %>

    <% if (process.env['FB_APP_ID']) { %>

    <!-- Facebook Pixel Code -->
    <!-- prettier-ignore -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');

      fbq.disablePushState = true;

      fbq('consent', 'revoke');
      fbq('init', '<%= process.env["FB_APP_ID"] %>');
      fbq('track', 'PageView');
    </script>

    <% } else { %>

    <script>
      function fbq() {}
    </script>

    <% } %>

    <noscript>
      <img
        height="1"
        width="1"
        style="display: none"
        src="https://www.facebook.com/tr?id=681854635902254&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Facebook Pixel Code -->

    <script type="module">
      function applyTheme() {
        const theme = (window.localStorage ?? window.localStorageFallback)?.getItem('fm.theme');

        const isDark =
          theme === 'dark' ||
          (theme !== 'light' &&
            window.matchMedia?.('(prefers-color-scheme: dark)').matches);

        document.documentElement.setAttribute(
          'data-bs-theme',
          isDark ? 'dark' : 'light',
        );
      }

      window
        .matchMedia?.('(prefers-color-scheme: dark)')
        ?.addEventListener('change', (e) => applyTheme());

      applyTheme();

      window.applyTheme = applyTheme;
    </script>

    <style>
      #app {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        top: 0;
      }

      #init-loader {
        background-color: white;
        color: #212529;
      }

      [data-bs-theme='dark'] #init-loader {
        background-color: #212529;
        color: #dee2e6;
      }
    </style>
  </head>

  <body>
    <div id="app">
      <div
        id="init-loader"
        style="
          display: flex;
          flex-direction: column;
          justify-content: center;
          height: 100dvh;
        "
      >
        <div style="display: flex; flex-direction: column; align-items: center">
          <div style="max-width: 200px; padding-bottom: 30px">
            <img
              src="freemap-logo-<%= site %>.svg"
              style="width: 100%; vertical-align: center"
            />
          </div>

          <div
            style="
              max-width: 400px;
              text-align: center;
              font-family: Arial, Helvetica, sans-serif;
              line-height: 1;
              margin-top: 0;
            "
          >
            <%= loadingMessage %>

            <noscript>
              <div
                style="
                  margin: 20px;
                  padding: 20px;
                  border: 6px solid red;
                  font-family: Arial, Helvetica, sans-serif;
                "
              >
                <%= nojsMessage %>
              </div>
            </noscript>
          </div>
        </div>
      </div>
    </div>

    <script>
      function _fm_showError() {
        // both are null while the document is being torn down (navigation away,
        // a page replaced by an in-app browser); there is nothing to report into
        var target = document.getElementById('app') || document.body;

        if (target) {
          // JSON.stringify, not a quoted literal: the message carries
          // apostrophes in some languages, which would break the script
          target.innerHTML = <%= JSON.stringify('<div style="margin: 20px; padding: 20px; border: 6px solid red; font-family: Arial, Helvetica, sans-serif;">' + errorHtml + '</div>') %>;
        }
      }
    </script>

    <script nomodule>
      _fm_showError();
    </script>

    <script type="module">
      (() => {
        // `main` sets `fmStarted` once it has handed the app to React; after
        // that, errors are the app's to handle.
        let failed = false;

        function fail() {
          failed = true;

          window.removeEventListener('error', onError);

          _fm_showError();
        }

        const mainUrl = new URL(
          <%= JSON.stringify(htmlWebpackPlugin.files.js.find((src) => src.startsWith('main.')) ?? '') %>,
          location.href,
        ).href;

        function onError(ev) {
          // Only `main`'s own error: any other script's, including one Sentry
          // rethrows from its wrappers, can't stop it; the `load` check catches
          // what this misses.
          if (!window.fmStarted && ev.filename === mainUrl) {
            console.error('Startup error.', ev);

            fail(); // Sentry's own handler reports the error
          }
        }

        window.addEventListener('error', onError);

        // Deferred scripts all run before `load`, so `main` failed to load or run.
        window.addEventListener('load', () => {
          window.removeEventListener('error', onError);

          if (!window.fmStarted && !failed) {
            console.error('Startup error: main did not run.');

            if (window.Sentry) {
              window.Sentry.captureMessage('Startup failed: main did not run', 'error');
            }

            fail();
          }
        });
      })();
    </script>

    <%= ['reporting.', 'main.'].map((prefix) =>
    htmlWebpackPlugin.files.js.find((src) => src.startsWith(prefix))).filter(Boolean).map((src) => `
    <script src="${src}" defer></script>
    `).join('') %>
  </body>
</html>
