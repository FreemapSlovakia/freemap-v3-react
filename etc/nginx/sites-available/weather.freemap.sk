# Weather API (LibreWXR) — what the `R` weather-radar overlay talks to.
#
# The app addresses metadata and tiles through a single origin (`LIBREWXR_URL`
# in rspack.config.ts), which is this vhost. Behind it, on the same host, runs
# our own LibreWXR: `docker compose` in ~/librewxr, single mode, published on
# loopback only, configured for Europe (OPERA + the Italian DPC composite).
#
# We run it ourselves rather than proxying the project's public instance because
# that one serves from several workers whose frame lists disagree — the same
# request answers with a forecast or without one depending on which worker takes
# it, so tiles of a frame the metadata just advertised come back 404 about half
# the time. Single mode is one process and one frame list.
#
# Requires conf.d/weather-cache.conf (cache zone + upstream), and
# $blocked_country from conf.d/geoip.conf.

server {
	server_name weather.freemap.sk;

	if ($blocked_country) {
		return 444;
	}

	add_header Alt-Svc 'h3=":$server_port"; ma=86400' always;

	# Nothing here needs to know who asked, and the layer sits on the map for as
	# long as a session lasts — so this vhost keeps no per-request record.
	access_log off;

	proxy_cache WEATHER;
	# LibreWXR's own `Cache-Control: max-age=300` is deliberately honoured — see
	# the tile location for why overriding it corrupts the picture.
	proxy_cache_lock on;
	# A new frame becomes visible to everyone at once, so without this the first
	# request for each of its tiles would be joined by every other client's.
	proxy_cache_lock_timeout 10s;
	proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
	proxy_cache_background_update on;
	proxy_cache_revalidate on;

	proxy_http_version 1.1;
	# Required for the upstream keepalive pool: without it nginx forwards the
	# client's Connection header and every upstream request closes.
	proxy_set_header Connection '';

	# The backend is ours, but it has no use for any of this — and an MCP
	# endpoint it should never see a credential on.
	proxy_set_header X-Forwarded-For '';
	proxy_set_header X-Real-IP '';
	proxy_set_header Cookie '';
	proxy_set_header Authorization '';
	proxy_set_header Referer '';

	# Fetch uncompressed so a URL has exactly one cache entry and no Vary; the
	# client still gets the JSON compressed, from the gzip below.
	proxy_set_header Accept-Encoding '';

	gzip on;
	gzip_types application/json application/geo+json;

	proxy_connect_timeout 5s;
	proxy_read_timeout 30s;

	# The upstream sends `Access-Control-Allow-Origin: *`; hide it rather than
	# add a second one, which browsers reject as a duplicate.
	proxy_hide_header Access-Control-Allow-Origin;
	proxy_hide_header Cache-Control;

	# Tiles: radar, satellite and the coverage mask.
	#
	# A tile is NOT immutable for its timestamp, however much the URL suggests
	# it. A frame's time is the moment it is valid for, not a version: the
	# forecast frames are re-computed every cycle as new radar arrives, under
	# the same timestamp. Cache one for hours and the tiles of a single frame
	# end up a mosaic of whichever version each was first fetched at — visible
	# on the map as rectangular blocks that don't line up with their neighbours.
	#
	# So the origin's own five minutes is the right lifetime and is left to
	# apply; five minutes still collapses the many clients watching the same
	# animation into one render each.
	location ~ ^/v2/(radar|satellite|coverage)/ {
		proxy_pass http://librewxr;

		# Only a fallback: the origin sends max-age, which nginx prefers.
		proxy_cache_valid 200 5m;
		# Above the renderer's max zoom every tile is a 400 — deterministic, so
		# the refusal is worth caching. A 404 is not: it means the frame has
		# rolled off the list, and pinning that would outlive the fact.
		proxy_cache_valid 400 1m;

		add_header Access-Control-Allow-Origin '*' always;
		# No `always`: that would put the lifetime on error responses too, and a
		# browser holding a cached 404 could never load that tile again.
		add_header Cache-Control 'public, max-age=300';
		add_header X-Cache-Status $upstream_cache_status always;
	}

	# The frame list. Short-lived: a new composite lands every ten minutes, and
	# this only has to stop every client fetching it for themselves.
	location = /public/weather-maps.json {
		proxy_pass http://librewxr;

		proxy_cache_valid 200 15s;
		proxy_cache_valid any 5s;

		add_header Access-Control-Allow-Origin '*' always;
		add_header Cache-Control 'public, max-age=15';
		add_header X-Cache-Status $upstream_cache_status always;
	}

	# CAP weather warnings — SHMÚ, CHMI, ZAMG and the rest, each already in its
	# own language. Not used by the app yet; served so the layer can grow into
	# it without another deploy. Keyed on the query string by the default key.
	location = /v2/alerts {
		proxy_pass http://librewxr;

		proxy_cache_valid 200 60s;
		proxy_cache_valid any 5s;

		add_header Access-Control-Allow-Origin '*' always;
		add_header Cache-Control 'public, max-age=60';
		add_header X-Cache-Status $upstream_cache_status always;
	}

	# A person who types the hostname gets the layer, not a 404 — the same
	# courtesy the other tile vhosts here do.
	location = / {
		return 302 https://www.freemap.sk/?map=8/48.705463/19.497986&layers=X~R;
	}

	# Uncached, for our own monitoring.
	location = /health {
		proxy_pass http://librewxr;

		proxy_cache off;

		add_header Cache-Control 'no-store' always;
	}

	# Everything else the backend exposes — /docs, /openapi.json, /mcp/ — is not
	# for the public, and an open MCP endpoint on our domain is not something to
	# offer by accident.
	location / {
		return 404;
	}

	http2 on;
	http3 on;

	listen 443 quic;
	listen [::]:443 quic;

	listen [::]:443 ssl; # managed by Certbot
	listen 443 ssl; # managed by Certbot
	ssl_certificate /etc/letsencrypt/live/weather.freemap.sk/fullchain.pem; # managed by Certbot
	ssl_certificate_key /etc/letsencrypt/live/weather.freemap.sk/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
	if ($host = weather.freemap.sk) {
		return 301 https://$host$request_uri;
	} # managed by Certbot

	server_name weather.freemap.sk;

	listen 80;
	listen [::]:80;
	return 404; # managed by Certbot
}
