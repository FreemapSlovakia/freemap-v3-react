#!/bin/bash
# Keeps the published MTA-STS policy in step with what the MX hosts can actually
# do. Promotes `testing` -> `enforce` after a clean soak, and drops back to
# `testing` when TLS breaks or the MX set drifts away from the policy's mx
# patterns — in `enforce` either one makes senders refuse to deliver.
# Recovery relies on the policy's max_age, not on a DNS edit: the `id` TXT
# record can only be changed by hand, so keep max_age short (a day).

set -uo pipefail

POLICY=${POLICY:-/var/www/mta-sts/.well-known/mta-sts.txt}
DOMAIN=${DOMAIN:-freemap.sk}
STATE=${STATE:-/var/lib/mta-sts-guard/state}
SOAK_DAYS=${SOAK_DAYS:-21}
FAIL_LIMIT=${FAIL_LIMIT:-2}

ok_streak=0
fail_streak=0
[[ -r $STATE ]] && . "$STATE"

die() {
	echo "$*" >&2
	exit 1
}

[[ -w $POLICY ]] || die "policy not writable: $POLICY"

mode=$(sed -n 's/^mode:[[:space:]]*\([a-z]*\).*/\1/p' "$POLICY" | head -1)
max_age=$(sed -n 's/^max_age:[[:space:]]*\([0-9]*\).*/\1/p' "$POLICY" | head -1)
mapfile -t patterns < <(sed -n 's/^mx:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$POLICY" | tr 'A-Z' 'a-z')

[[ -n $mode && -n $max_age && ${#patterns[@]} -gt 0 ]] ||
	die "cannot parse policy: $POLICY"

# A DNS hiccup must not look like a TLS failure, so bail out without touching
# the streaks.
mapfile -t mx < <(dig +short MX "$DOMAIN" | sort -n |
	sed 's/^[0-9]*[[:space:]]*//; s/\.$//' | tr 'A-Z' 'a-z' | grep .)

[[ ${#mx[@]} -gt 0 ]] || die "no MX for $DOMAIN — leaving policy at '$mode'"

covered() {
	local host=$1 pat suffix
	for pat in "${patterns[@]}"; do
		if [[ $pat == '*.'* ]]; then
			suffix=${pat#'*.'}
			# A wildcard covers exactly one label.
			[[ $host == *.$suffix && ${host%".$suffix"} != *.* ]] && return 0
		elif [[ $host == "$pat" ]]; then
			return 0
		fi
	done
	return 1
}

all_ok=1

for host in "${mx[@]}"; do
	if ! covered "$host"; then
		echo "MX $host is not covered by the policy's mx patterns"
		all_ok=0
		continue
	fi

	# -verify_hostname is the point: a trusted chain for the wrong name is
	# exactly what MTA-STS exists to reject.
	if timeout 30 openssl s_client -starttls smtp -connect "$host:25" \
		-servername "$host" -verify_hostname "$host" -verify_return_error \
		</dev/null 2>&1 | grep -q 'Verify return code: 0 '; then
		echo "MX $host OK"
	else
		echo "MX $host FAILED TLS validation"
		all_ok=0
	fi
done

if ((all_ok)); then
	((ok_streak++))
	fail_streak=0
else
	((fail_streak++))
	ok_streak=0
fi

write_policy() {
	local new=$1 tmp=$POLICY.tmp
	{
		printf 'version: STSv1\r\n'
		printf 'mode: %s\r\n' "$new"
		printf 'mx: %s\r\n' "${patterns[@]}"
		printf 'max_age: %s\r\n' "$max_age"
	} >"$tmp" && chmod 644 "$tmp" && mv "$tmp" "$POLICY"
}

if [[ $mode == testing ]] && ((ok_streak >= SOAK_DAYS)); then
	write_policy enforce && mode=enforce &&
		echo "PROMOTED to enforce after $ok_streak clean days"
elif [[ $mode == enforce ]] && ((fail_streak >= FAIL_LIMIT)); then
	write_policy testing && mode=testing && ok_streak=0 &&
		echo "REVERTED to testing after $fail_streak failed days — fix the MX, senders recover within max_age ($max_age s)"
fi

mkdir -p "$(dirname "$STATE")"
printf 'ok_streak=%s\nfail_streak=%s\nmode=%s\nchecked=%s\n' \
	"$ok_streak" "$fail_streak" "$mode" "$(date -Is)" >"$STATE"

echo "mode=$mode ok_streak=$ok_streak fail_streak=$fail_streak"
