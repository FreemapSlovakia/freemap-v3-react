# Schedules freemap-mta-sts-guard.service. Daily is the resolution the guard
# counts in: three clean weeks promote, two failed days revert.
# Reference copy of what is deployed.

[Unit]
Description=Daily MTA-STS policy guard

[Timer]
OnCalendar=*-*-* 04:20:00
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
