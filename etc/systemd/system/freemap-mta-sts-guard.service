# Daily MTA-STS policy guard for freemap.sk. Promotes the published policy from
# `testing` to `enforce` once every MX has validated for three weeks running,
# and drops it back to `testing` if TLS or the MX set later breaks — nobody
# reads mail on this host, so the policy has to look after itself.
#
# Reference copy of what is deployed — see README "Scheduled jobs (systemd)".

[Unit]
Description=Guard the published MTA-STS policy for freemap.sk
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mta-sts-guard
StateDirectory=mta-sts-guard
# Writing the policy is the only reason this needs root.
ProtectSystem=strict
ReadWritePaths=/var/www/mta-sts
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
